<UserControl
    x:Class="WordPad.WordPadUI.Ribbon.InsertToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordPad.WordPadUI.Ribbon"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="120"
    d:DesignWidth="184">

    <Grid BorderBrush="{ThemeResource RibbonColumnBorder}"
      BorderThickness="0,0,0,0"
      Grid.Column="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="72" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>
            <Button x:Name="InsertImageButton" Grid.Row="1" Style="{StaticResource PaintUIButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top"
       Width="32"
     MinWidth="32"
     MaxWidth="32"
     Height="15" FontSize="10" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Button.Content>
                    <Grid>
                        <TextBlock FontFamily="{StaticResource SegoeFluentIcons}" Text="" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Name="MenuPicture" x:Uid="menupicture" Click="InsertImageButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xe91b;" FontFamily="Segoe Fluent Icons" FontSize="22" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuChangePicture" IsEnabled="False" x:Uid="menuchangepicture">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="22" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuResizePicture" IsEnabled="False" x:Uid="menuresizepicture">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="22" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>


            </Button>

            <Button x:Name="InsertImageButtona"  Style="{StaticResource PaintUIButtonStyle}" Click="InsertImageButton_Click" HorizontalAlignment="Stretch" Height="32" VerticalAlignment="Center" >

                <Grid Height="22" Width="22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <Image Width="24" Height="22" Source="{Binding Source={ThemeResource Image}}" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Picture" x:Uid="TooltipPicture"/>
                </ToolTipService.ToolTip>
            </Button>

            <Button x:Name="InsertDateAndTimeButton" Style="{StaticResource PaintUIButtonStyle}"
     Width="32"
     MinWidth="32"
     MaxWidth="32"
     Height="32"
     Grid.Column="3" Click="InsertDateAndTimeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2"
     >
                <Grid>
                    <Image Width="22" Height="22" Source="{Binding Source={ThemeResource Date}}" VerticalAlignment="Top" Stretch="UniformToFill" HorizontalAlignment="Center" />
                </Grid>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Date and time" x:Uid="TooltipDateTime" />
                </ToolTipService.ToolTip>
            </Button>

            <Button x:Name="InsertObjectButton" Style="{StaticResource PaintUIButtonStyle}"
     Width="32"
     MinWidth="32"
     MaxWidth="32"
     Height="32"
     Grid.Column="2" Click="InsertObjectButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Content>
                    <Grid>
                        <Image Width="22" Height="22" Source="{Binding Source={ThemeResource Objects}}" VerticalAlignment="Center" Stretch="Fill" HorizontalAlignment="Center" />
                    </Grid>
                </Button.Content>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Insert object" x:Uid="TooltipObject" />
                </ToolTipService.ToolTip>
            </Button>
            <Button x:Name="InsertPaintImageButton" Style="{StaticResource PaintUIButtonStyle}"
Width="32"
MinWidth="32"
MaxWidth="32"
Height="32"
Grid.Column="1" Click="InsertPaintImageButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Image Width="22" Height="22" Source="{Binding Source={ThemeResource PaintImage}}" VerticalAlignment="Center" Stretch="Fill" HorizontalAlignment="Center" />
                </Grid>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Paint drawing" x:Uid="TooltipPaint" />
                </ToolTipService.ToolTip>
            </Button>


        </Grid>
        <TextBlock x:Uid="insertbox"
               Style="{StaticResource ColumnDescriptionTextblockStyle}"
               Grid.Row="1" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>   
     
    
</UserControl>
