<UserControl
    x:Class="WordPad.WordPadUI.Ribbon.EditingToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordPad.WordPadUI.Ribbon"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="120"
    d:DesignWidth="140">

    <Grid x:Name="EditionGrid" BorderBrush="{ThemeResource RibbonColumnBorder}"
    BorderThickness="0,0,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="72" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" RowSpacing="1" HorizontalAlignment="Center" Margin="0,4,0,0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <muxc:DropDownButton Width="132" x:Name="ReplaceButton" Style="{StaticResource PaintUIButtonStyle}"
                Grid.Row="1" Click="ReplaceButton_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <muxc:DropDownButton.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="19" Height="16" Source="{Binding Source={ThemeResource Replace}}" HorizontalAlignment="Center" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,0,0" />
                        <TextBlock Grid.Column="1" x:Uid="EditingReplaceBox" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Left" Margin="5,1,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </muxc:DropDownButton.Content>
                <muxc:DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                        Margin="0,0,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Find" />

                            <TextBox
                        x:Name="findBox"
                        Width="330"
                        PlaceholderText="Text to look for" />
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,10,0,0" Click="FindButton_Click">Find</Button>
                                <Button Margin="5,10,0,0" Click="RemoveHighlightButton_Click">Remove highlights</Button>
                            </StackPanel>

                            <TextBlock
                        Margin="0,10,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Replace" />
                            <TextBox
                        x:Name="replaceBox"
                        Width="330"
                        PlaceholderText="New text" />
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,10,0,0" Click="ReplaceSelected_Click">Replace selected text</Button>
                                <Button Margin="5,10,0,0" Click="ReplaceAll_Click">Replace all occurrences</Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </muxc:DropDownButton.Flyout>
            </muxc:DropDownButton>



            <muxc:DropDownButton Width="132" x:Name="FindButton" Style="{StaticResource PaintUIButtonStyle}"
    Grid.Row="0" HorizontalAlignment="Stretch" Click="FindButton_Click"  VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="1,0,0,0">
                <muxc:DropDownButton.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE11A;" FontFamily="{StaticResource SegoeFluentIcons}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,0,0" ></TextBlock>
                        <TextBlock Grid.Column="1" x:Uid="EditingFindBox" HorizontalAlignment="Left" Margin="5,1,0,0" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </muxc:DropDownButton.Content>
                <muxc:DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                        Margin="0,0,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Find" />

                            <TextBox
                        x:Name="replacefindBox"
                        Width="330"
                        PlaceholderText="Text to look for" />
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,10,0,0" Click="FindButton_Click">Find</Button>
                                <Button Margin="5,10,0,0" Click="RemoveHighlightButton_Click">Remove highlights</Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </muxc:DropDownButton.Flyout>
            </muxc:DropDownButton>
            <Button Width="132" x:Name="SelectAllButton" Style="{StaticResource PaintUIButtonStyle}"
                Grid.Row="2" HorizontalAlignment="Stretch" Click="SelectAllButton_Click" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="17" Height="17" Source="{Binding Source={ThemeResource SelectAll}}" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock Grid.Column="1" x:Name="textBlock" x:Uid="EditingSelAllBox" HorizontalAlignment="Left"  TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Margin="5,1,0,0" FontSize="12"/>
                    </Grid>
                </Button.Content>
            </Button>

        </Grid>
        <TextBlock x:Uid="EditingText"
               Style="{StaticResource ColumnDescriptionTextblockStyle}"
               Grid.Row="1" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>
</UserControl>
